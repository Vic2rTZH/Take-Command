# Public address of the site, no trailing slash
NEXT_PUBLIC_SITE_URL=https://takecommand.bantuwa.org

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel: comma-separated emails allowed to sign in
ADMIN_EMAILS=

# Resend
RESEND_API_KEY=
# Must use a domain verified in Resend
EMAIL_FROM=Victor Simz <hello@takecommand.bantuwa.org>
EMAIL_REPLY_TO=

# Any long random string; used to anonymise visitor counts
ANALYTICS_SALT=
# Time zone for daily analytics
ANALYTICS_TZ=Africa/Lusaka
